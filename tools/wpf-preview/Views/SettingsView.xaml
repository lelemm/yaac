<UserControl x:Class="Yaac.WpfPreview.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Focusable="True"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             PreviewKeyDown="HandleKey" PreviewMouseDown="HandleMouse">
    <Grid Background="{DynamicResource YaacCanvas}"
          TextElement.Foreground="{DynamicResource YaacText}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="Navigation" Background="{DynamicResource YaacPanel}"
                BorderBrush="{DynamicResource YaacRule}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,7,12,0">
                <Button DockPanel.Dock="Top" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,0,0,14" Click="CloseClicked" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Back to threads" ToolTip="Esc">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" Margin="0,0,7,0"/>
                        <TextBlock Text="Back to threads"/>
                    </StackPanel>
                </Button>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="Pages" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource YaacNavigationItem}"
                             SelectionChanged="PageChanged" AutomationProperties.Name="Settings pages"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      PreviewMouseWheel="HandleScrollInput">
            <ContentControl x:Name="SurfaceHost" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" Focusable="False"/>
        </ScrollViewer>
    </Grid>
</UserControl>
