<UserControl x:Class="Yaac.WpfPreview.Views.FilesTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TreeView x:Name="Tree" BorderThickness="0" Padding="5"
            AutomationProperties.Name="Worktree files"
            Background="{DynamicResource YaacCanvas}" Foreground="{DynamicResource YaacText}"
            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
            VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
    <TreeView.ItemContainerStyle>
      <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TreeViewItem">
              <StackPanel>
                <Border x:Name="Row" MouseLeftButtonUp="FolderRowClicked" Height="24" CornerRadius="3" Background="Transparent">
                  <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                </Border>
                <ItemsPresenter x:Name="Children" Margin="16,0,0,0"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Children" Property="Visibility" Value="Collapsed"/></Trigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource YaacHover}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource YaacSelected}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=OneWay}" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="Foreground" Value="{DynamicResource YaacText}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Ignored}" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource YaacMuted}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </TreeView.ItemContainerStyle>
    <TreeView.ItemTemplate>
      <HierarchicalDataTemplate ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal">
          <Button AutomationProperties.Name="{Binding Name}" Style="{StaticResource YaacQuietButton}"
                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                  HorizontalContentAlignment="Left" Padding="3,1" ToolTip="{Binding Path}"
                  IsEnabled="{Binding CanOpen}" Click="OpenName" PreviewMouseDown="MiddleName">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,5,0" Stroke="{DynamicResource YaacMuted}" StrokeThickness="1.35" StrokeLineJoin="Round">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Data" Value="M3 1 H9 L13 5 V15 H3 Z M9 1 V5 H13"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Directory}" Value="True"><Setter Property="Data" Value="M1 4 Q1 3 2 3 H6 L8 5 H14 Q15 5 15 6 V13 H1 Z"/></DataTrigger>
                      <DataTrigger Binding="{Binding Expanded}" Value="True"><Setter Property="Data" Value="M1 13 V3 H6 L8 5 H13 V7 M1 13 L3 7 H15 L13 13 Z"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock Text="●" Foreground="{DynamicResource YaacWarning}" Margin="4,0"
                     FontSize="8" VerticalAlignment="Center" ToolTip="Contains changes">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ChangedFolder}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button Content="{Binding Mark}" Style="{StaticResource YaacQuietButton}"
                  Visibility="{Binding MarkVisibility}" Foreground="{Binding MarkBrush}" Padding="4,1"
                  ToolTip="{Binding MarkLabel}" AutomationProperties.Name="{Binding MarkLabel}"
                  Click="OpenMark" PreviewMouseDown="MiddleMark" />
        </StackPanel>
      </HierarchicalDataTemplate>
    </TreeView.ItemTemplate>
  </TreeView>
</UserControl>
