<UserControl x:Class="Yaac.WpfPreview.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Yaac.WpfPreview.Views"
             xmlns:preview="clr-namespace:Yaac.WpfPreview"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Loaded="OnLoaded" Background="{DynamicResource YaacPanel}"
             Foreground="{DynamicResource YaacText}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="SidebarBooleanVisibility" />

    <Style x:Key="SidebarLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource YaacText}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SidebarQuietLabel" TargetType="TextBlock" BasedOn="{StaticResource SidebarLabel}">
      <Setter Property="Foreground" Value="{DynamicResource YaacMuted}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="SidebarOptionalLabel" TargetType="TextBlock" BasedOn="{StaticResource SidebarQuietLabel}">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarSmallButton" TargetType="Button" BasedOn="{StaticResource YaacQuietButton}">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <DataTemplate x:Key="SidebarActionButton">
      <Button Style="{StaticResource SidebarSmallButton}" Margin="2,0,0,0"
              Content="{Binding Label}" IsEnabled="{Binding Enabled}" ToolTip="{Binding ToolTip}"
              Click="OnBarAction" />
    </DataTemplate>
    <ItemsPanelTemplate x:Key="SidebarActionPanel">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <DataTemplate x:Key="SidebarHeaderTemplate">
      <Grid x:Name="Header" Height="26" Margin="2,0" Background="Transparent"
            ToolTip="{Binding State.ToolTip}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <DockPanel x:Name="StaticHeading" LastChildFill="True" Margin="3,0,4,0">
          <TextBlock DockPanel.Dock="Left" Text="{Binding State.HeaderGlyph}"
                     Style="{StaticResource SidebarOptionalLabel}" />
          <TextBlock x:Name="HeaderTitle" Text="{Binding State.Title}" FontWeight="SemiBold"
                     Style="{StaticResource SidebarQuietLabel}" />
        </DockPanel>
        <Button x:Name="Toggle" Grid.Column="0" Background="Transparent" BorderBrush="Transparent"
                Padding="0" HorizontalContentAlignment="Stretch"
                Style="{StaticResource SidebarSmallButton}" Click="OnHeaderToggle"
                IsEnabled="{Binding State.Toggle.Enabled}" ToolTip="{Binding State.Toggle.ToolTip}"
                AutomationProperties.Name="{Binding State.Toggle.Label}"
                Visibility="Collapsed">
          <DockPanel Margin="3,0,4,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding State.HeaderGlyph}"
                       Style="{StaticResource SidebarOptionalLabel}" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding State.TemporaryGlyph}"
                       Style="{StaticResource SidebarOptionalLabel}" />
            <TextBlock Text="{Binding State.Title}" FontWeight="SemiBold"
                       Style="{StaticResource SidebarQuietLabel}" />
          </DockPanel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock Text="⚠" Style="{StaticResource SidebarQuietLabel}" Margin="0,0,5,0"
                     Visibility="{Binding State.OlderDaemon, Converter={StaticResource SidebarBooleanVisibility}}"
                     ToolTip="The daemon on this machine is older" />
          <TextBlock Text="{Binding State.Machine}" MaxWidth="84" ToolTip="{Binding State.Machine}"
                     Style="{StaticResource SidebarOptionalLabel}" />
          <TextBlock Text="{Binding State.Mark}" Style="{StaticResource SidebarOptionalLabel}" />
          <TextBlock Text="{Binding State.Connection}" MaxWidth="108" ToolTip="{Binding State.Connection}"
                     Style="{StaticResource SidebarOptionalLabel}" />
          <Button x:Name="HeaderAction" Style="{StaticResource SidebarSmallButton}"
                  Content="{Binding State.Primary.Label}" IsEnabled="{Binding State.Primary.Enabled}"
                  ToolTip="{Binding State.Primary.ToolTip}" Click="OnHeaderAction" />
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State.Temporary}" Value="True">
          <Setter TargetName="HeaderTitle" Property="FontStyle" Value="Italic" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Primary}" Value="{x:Null}">
          <Setter TargetName="HeaderAction" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.HasToggle}" Value="True">
          <Setter TargetName="Toggle" Property="Visibility" Value="Visible" />
          <Setter TargetName="StaticHeading" Property="Visibility" Value="Hidden" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
          <Setter TargetName="Header" Property="Background" Value="{DynamicResource YaacRaised}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
          <Setter TargetName="Header" Property="Background" Value="{DynamicResource YaacSelected}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="SidebarRowTemplate">
      <Border x:Name="Plate" CornerRadius="5" BorderThickness="1" Background="Transparent"
              BorderBrush="Transparent" Margin="1" ToolTip="{Binding State.ToolTip}">
        <Grid>
          <Border x:Name="MultiBar" Width="3" CornerRadius="1.5" Margin="1,4,0,4"
                  HorizontalAlignment="Left" Background="{DynamicResource YaacText}" Visibility="Collapsed" />
          <Grid Margin="7,0,6,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="24" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Mark" Text="{Binding State.Mark}"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource YaacMuted}"
                         VerticalAlignment="Center" HorizontalAlignment="Left" />
              <preview:RunningSpinner x:Name="RowSpinner" Visibility="Collapsed" Width="14" Height="14"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Foreground="{DynamicResource YaacText}" />
              <TextBlock Grid.Column="1" Text="&#xEA75;"
                         Style="{StaticResource SidebarQuietLabel}" Margin="0,0,5,0" ToolTip="Read-only"
                         Visibility="{Binding State.ReadOnly, Converter={StaticResource SidebarBooleanVisibility}}" />
              <TextBlock x:Name="Title" Grid.Column="2" Text="{Binding State.Title}"
                         Style="{StaticResource SidebarLabel}" />
              <TextBlock Grid.Column="3" Text="&#xEA63;"
                         Style="{StaticResource SidebarQuietLabel}" Margin="4,0,0,0" ToolTip="Forked thread"
                         Visibility="{Binding State.Forked, Converter={StaticResource SidebarBooleanVisibility}}" />
              <Button x:Name="Badge" Grid.Column="4" Style="{StaticResource SidebarSmallButton}"
                      Content="{Binding State.Badge.Label}" IsEnabled="{Binding State.Badge.Enabled}"
                      ToolTip="{Binding State.Badge.ToolTip}" Click="OnRowBadge" Margin="4,0,0,0" />
              <TextBlock Grid.Column="5" x:Name="Right" Text="{Binding State.Right}"
                         Style="{StaticResource SidebarOptionalLabel}" Margin="6,0,0,0" />
            </Grid>
            <DockPanel Grid.Row="1" Margin="18,0,0,1"
                       Visibility="{Binding State.HasLine2, Converter={StaticResource SidebarBooleanVisibility}}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding State.Workers}" ToolTip="Direct workers"
                         Style="{StaticResource SidebarOptionalLabel}" Margin="5,0,0,0" />
              <Path DockPanel.Dock="Left" Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0"
                    VerticalAlignment="Center" Data="{Binding State.ProviderLogo}"
                    Fill="{Binding State.ProviderLogoColor}" ToolTip="{Binding State.Provider}"
                    AutomationProperties.Name="{Binding State.Provider}">
                <Path.Style>
                  <Style TargetType="Path">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding State.ProviderLogo}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
              <TextBlock DockPanel.Dock="Left" Text="{Binding State.Provider}" MaxWidth="68"
                         ToolTip="{Binding State.Provider}" Style="{StaticResource SidebarOptionalLabel}" />
              <DockPanel HorizontalAlignment="Left">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <TextBlock Text="{Binding State.Added}" Foreground="{DynamicResource YaacSuccess}" ToolTip="Files added"
                             Style="{StaticResource SidebarOptionalLabel}" />
                  <TextBlock Text="{Binding State.Modified}" Foreground="{DynamicResource YaacWarning}" ToolTip="Files modified"
                             Style="{StaticResource SidebarOptionalLabel}" />
                  <TextBlock Text="{Binding State.Deleted}" Foreground="{DynamicResource YaacFailure}" ToolTip="Files deleted"
                             Style="{StaticResource SidebarOptionalLabel}" />
                  <TextBlock Text="{Binding State.Ahead}" ToolTip="Commits ahead" Style="{StaticResource SidebarOptionalLabel}" />
                  <TextBlock Text="{Binding State.Behind}" ToolTip="Commits behind" Style="{StaticResource SidebarOptionalLabel}" />
                </StackPanel>
                <TextBlock Text="{Binding State.BranchLabel}" ToolTip="{Binding State.Branch}"
                           Style="{StaticResource SidebarOptionalLabel}" />
              </DockPanel>
            </DockPanel>
          </Grid>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Plate" Property="IsMouseOver" Value="True">
          <Setter TargetName="Plate" Property="Background" Value="{DynamicResource YaacRaised}" />
        </Trigger>
        <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
          <Setter TargetName="Plate" Property="Background" Value="{DynamicResource YaacRaised}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Unseen}" Value="True">
          <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource YaacUnread}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Selected}" Value="True">
          <Setter TargetName="Plate" Property="Background" Value="{DynamicResource YaacSelected}" />
          <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource YaacRule}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMulti}" Value="True">
          <Setter TargetName="Plate" Property="Background" Value="{DynamicResource YaacSelected}" />
          <Setter TargetName="Plate" Property="BorderBrush" Value="Transparent" />
          <Setter TargetName="MultiBar" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
          <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource YaacUnread}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Tone}" Value="done">
          <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource YaacSuccess}" />
          <Setter TargetName="Mark" Property="FontSize" Value="17" />
          <Setter TargetName="Mark" Property="FontWeight" Value="Bold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.MarkDanger}" Value="True">
          <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource YaacFailure}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Tone}" Value="running">
          <Setter TargetName="Mark" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="RowSpinner" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Fast}" Value="True">
          <Setter TargetName="RowSpinner" Property="Foreground" Value="{DynamicResource YaacFast}" />
          <Setter TargetName="RowSpinner" Property="Fast" Value="True" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Ultrafast}" Value="True">
          <Setter TargetName="RowSpinner" Property="Foreground" Value="{DynamicResource YaacUltrafast}" />
          <Setter TargetName="RowSpinner" Property="Ultrafast" Value="True" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Dimmed}" Value="True">
          <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource YaacMuted}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Badge}" Value="{x:Null}">
          <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="SidebarStatusTemplate">
      <TextBlock Text="{Binding State.Title}" Margin="7,0"
                 Style="{StaticResource SidebarQuietLabel}" ToolTip="{Binding State.Title}" />
    </DataTemplate>
    <DataTemplate x:Key="SidebarMoreTemplate">
      <Button HorizontalAlignment="Left" Margin="6,0" Style="{StaticResource SidebarSmallButton}"
              Content="{Binding State.Title}" IsEnabled="{Binding State.Primary.Enabled}"
              ToolTip="{Binding State.Primary.ToolTip}" Click="OnSearchMore" />
    </DataTemplate>

    <Style x:Key="SidebarContainer" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource YaacText}" />
      <Setter Property="Height" Value="{Binding Height}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding State.Title}" />
      <Setter Property="AutomationProperties.ItemStatus" Value="{Binding State.AccessibilityStatus}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ContentTemplate" Value="{StaticResource SidebarRowTemplate}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Background="Transparent">
              <ContentPresenter x:Name="Content" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
              <Border x:Name="FocusOutline" CornerRadius="5" BorderThickness="1" Margin="1"
                      IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding GappedHeader}" Value="True">
                <Setter TargetName="Content" Property="Margin" Value="0,12,0,0" />
              </DataTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusOutline" Property="BorderBrush" Value="{DynamicResource YaacUnread}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Header">
          <Setter Property="ContentTemplate" Value="{StaticResource SidebarHeaderTemplate}" />
          <Setter Property="Focusable" Value="False" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="More">
          <Setter Property="ContentTemplate" Value="{StaticResource SidebarMoreTemplate}" />
          <Setter Property="Focusable" Value="False" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Status">
          <Setter Property="ContentTemplate" Value="{StaticResource SidebarStatusTemplate}" />
          <Setter Property="Focusable" Value="False" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="12,0,12,6">
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="NewButton" Click="OnNew" Padding="10,3" Visibility="Collapsed"
                AutomationProperties.Name="New thread" ToolTip="New thread" />
        <Button x:Name="CollapseButton" Content="◫" Width="26" Padding="0"
                Foreground="{DynamicResource YaacMuted}" AutomationProperties.Name="Collapse sidebar"
                ToolTip="Collapse the sidebar (Ctrl+B)" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="YAAC" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
        <Button x:Name="BackButton" Content="‹" Width="24" Padding="0" FontSize="19"
                AutomationProperties.Name="Back" ToolTip="Back (Alt+Left)" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        <Button x:Name="ForwardButton" Content="›" Width="24" Padding="0" FontSize="19"
                AutomationProperties.Name="Forward" ToolTip="Forward (Alt+Right)" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        <Button x:Name="NeedsButton" Foreground="{DynamicResource YaacFailure}" Padding="5,2"
                AutomationProperties.Name="Needs you" ToolTip="Next thread that needs you (Ctrl+J)"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="{DynamicResource YaacInput}" CornerRadius="6" Padding="5,1" Margin="0,6,0,8">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="⌕" FontSize="19" Foreground="{DynamicResource YaacMuted}"
                 Margin="4,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1" />
      <TextBox x:Name="SearchBox" MinHeight="32" Padding="25,3,3,3" Background="Transparent"
               BorderThickness="0"
               VerticalContentAlignment="Center" AutomationProperties.Name="Search threads"
               TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />
      <TextBlock Text="Search…" IsHitTestVisible="False" Margin="27,0,0,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource SidebarQuietLabel}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <Button x:Name="ClearSearch" Grid.Column="1" Content="×" AutomationProperties.Name="Clear search"
              ToolTip="Clear search" Margin="2,0,0,0" Click="OnClearSearch">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource SidebarSmallButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsEnabled, ElementName=SearchBox}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button x:Name="OrderButton" Grid.Column="2" Content="⇅" Style="{StaticResource SidebarSmallButton}"
              AutomationProperties.Name="Order threads" ToolTip="Order" Margin="3,0,0,0"
              Visibility="Collapsed" Click="OnOrder" />
      <Button x:Name="GroupButton" Grid.Column="3" Content="☰" Style="{StaticResource SidebarSmallButton}"
              AutomationProperties.Name="Group threads" ToolTip="Grouping" Margin="3,0,0,0"
              Visibility="Collapsed" Click="OnGroup" />
    </Grid>
    </Border>

    <Grid x:Name="ListHost" Grid.Row="2" Margin="0,0,-12,0" ClipToBounds="True" Background="Transparent"
          AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop" DragLeave="OnDragLeave"
          MouseLeave="OnListLeave" PreviewMouseLeftButtonDown="OnListDown"
          PreviewMouseLeftButtonUp="OnListUp" PreviewMouseMove="OnListMove"
          PreviewMouseRightButtonUp="OnListMenu" PreviewKeyDown="OnListKeyDown">
      <ListBox x:Name="Threads" AutomationProperties.Name="Threads"
               Style="{StaticResource YaacVerticalList}"
               Background="Transparent" BorderThickness="0" Padding="0,0,6,0" SelectionMode="Multiple"
               ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.ScrollChanged="OnScrolled"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
               VirtualizingPanel.ScrollUnit="Pixel" ItemContainerStyle="{StaticResource SidebarContainer}" />
      <ContentControl x:Name="StickyHeader" Visibility="Collapsed"
                      Height="26" VerticalAlignment="Top" HorizontalAlignment="Left"
                      HorizontalContentAlignment="Stretch" Focusable="False"
                      Background="{DynamicResource YaacPanel}" ContentTemplate="{StaticResource SidebarHeaderTemplate}"
                      PreviewMouseWheel="OnStickyWheel">
        <ContentControl.RenderTransform>
          <TranslateTransform x:Name="StickyOffset" />
        </ContentControl.RenderTransform>
      </ContentControl>
      <Popup x:Name="DropHint" Placement="RelativePoint" AllowsTransparency="True"
             PlacementTarget="{Binding ElementName=ListHost}" Focusable="False" IsHitTestVisible="False">
        <Border Background="{DynamicResource YaacPanel}" BorderBrush="{DynamicResource YaacRule}" BorderThickness="1"
                Padding="8,5" CornerRadius="5">
          <TextBlock x:Name="DropText" MaxWidth="280" TextWrapping="Wrap"
                     Foreground="{DynamicResource YaacText}" FontSize="11" />
        </Border>
      </Popup>
    </Grid>

    <Border x:Name="SelectionBar" Grid.Row="3" Background="{DynamicResource YaacSelected}" CornerRadius="5"
            Margin="0,4,0,0" Padding="5,3" Visibility="Collapsed">
      <DockPanel>
        <Button x:Name="ClearSelection" DockPanel.Dock="Right" Content="×"
                Style="{StaticResource SidebarSmallButton}" AutomationProperties.Name="Clear selection"
                ToolTip="Clear selection (Esc)" Click="OnClearSelection" />
        <Button x:Name="MoreBulkActions" DockPanel.Dock="Right" Content="⋯"
                Style="{StaticResource SidebarSmallButton}" AutomationProperties.Name="Selection actions"
                ToolTip="More selection actions" Click="OnMoreBulk" Visibility="Collapsed" />
        <ItemsControl x:Name="SelectionActions" DockPanel.Dock="Right"
                      ItemsPanel="{StaticResource SidebarActionPanel}" ItemTemplate="{StaticResource SidebarActionButton}" />
        <TextBlock x:Name="SelectionLabel" Margin="3,0,4,0" Style="{StaticResource SidebarQuietLabel}" />
      </DockPanel>
    </Border>

    <StackPanel x:Name="SidebarFooter" Grid.Row="4" Margin="0,5,0,0">
      <local:UsageMeter x:Name="Usage" Margin="0,0,0,5" Visibility="Collapsed" />
      <Button x:Name="ScenesButton" Content="Demo: play the story" HorizontalAlignment="Left" />
      <DockPanel>
        <Button x:Name="SettingsButton" DockPanel.Dock="Left" AutomationProperties.Name="Settings"
                Content="⚙  Settings" ToolTip="Settings (Ctrl+,)" Padding="4,3" />
        <ItemsControl x:Name="FooterActions" DockPanel.Dock="Left"
                      ItemsPanel="{StaticResource SidebarActionPanel}" ItemTemplate="{StaticResource SidebarActionButton}" />
        <TextBlock x:Name="FooterLabel" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SidebarQuietLabel}" />
      </DockPanel>
    </StackPanel>
  </Grid>
</UserControl>
