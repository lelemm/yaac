<UserControl x:Class="Yaac.WpfPreview.Views.AgentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preview="clr-namespace:Yaac.WpfPreview"
             xmlns:local="clr-namespace:Yaac.WpfPreview.Views"
             Focusable="False" Visibility="Collapsed" UseLayoutRounding="True"
             SnapsToDevicePixels="True" Unloaded="OnUnloaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="AgentsVisible" />

    <Style x:Key="AgentsText" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="AgentsMeta" TargetType="TextBlock" BasedOn="{StaticResource AgentsText}">
      <Setter Property="Foreground" Value="{DynamicResource YaacMuted}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="AgentsLink" TargetType="Button" BasedOn="{StaticResource YaacQuietButton}">
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <DataTemplate x:Key="AgentsHarness">
      <Grid Width="27" Height="27">
        <Border x:Name="Initial" Width="20" Height="20" Background="Transparent"
                BorderBrush="{DynamicResource YaacMuted}" BorderThickness="1" CornerRadius="10">
          <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Path x:Name="Logo" Data="{Binding Logo}" Fill="{Binding LogoColor}"
              Stretch="Uniform" Width="20" Height="20" Visibility="Collapsed" />
        <Border CornerRadius="14" BorderBrush="{DynamicResource YaacUnread}"
                BorderThickness="1.5" Visibility="{Binding Unseen, Converter={StaticResource AgentsVisible}}" />
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Width="12" Height="12" CornerRadius="6" Background="{DynamicResource YaacRaised}"
                Visibility="{Binding Attention, Converter={StaticResource AgentsVisible}}">
          <TextBlock Text="!" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource YaacFailure}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasLogo}" Value="True">
          <Setter TargetName="Logo" Property="Visibility" Value="Visible" />
          <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Finished}" Value="True">
          <Setter TargetName="Logo" Property="Opacity" Value="0.53" />
          <Setter TargetName="Initial" Property="Opacity" Value="0.53" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="AgentsPillRow">
      <Button Style="{StaticResource AgentsLink}" Padding="0" Height="32"
              IsTabStop="False" Focusable="False" IsEnabled="{Binding Data.CanOpen}"
              HorizontalContentAlignment="Center" Click="OpenAgent" ToolTip="{Binding Data.Tooltip}"
              ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Data.Tooltip}">
        <Grid Width="36">
          <ContentControl Content="{Binding Data}" ContentTemplate="{StaticResource AgentsHarness}"
                          IsTabStop="False" Focusable="False" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Data.Flow}" HorizontalAlignment="Right"
                     FontSize="12" FontWeight="SemiBold" />
        </Grid>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="AgentsPillLabel">
      <TextBlock Text="{Binding Data.Title}" ToolTip="{Binding Data.Tooltip}"
                 FontSize="12" FontWeight="SemiBold" Height="16"
                 Foreground="{Binding Data.MarkColor}" TextAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="AgentsRuleLine">
      <Border Height="1" Width="20" Background="{DynamicResource YaacRule}" Margin="0,4" />
    </DataTemplate>
    <DataTemplate x:Key="AgentsMore">
      <Button Style="{StaticResource AgentsLink}" Padding="0,2" HorizontalContentAlignment="Stretch"
              Focusable="False" IsTabStop="False" MouseEnter="OnMoreEnter" Click="OnMoreClick"
              ToolTip="{Binding Data.Tooltip}" AutomationProperties.Name="{Binding Data.Tooltip}">
        <Grid>
          <TextBlock Text="{Binding Data.Title}" TextAlignment="Center" FontSize="10"
                     Foreground="{DynamicResource YaacMuted}" />
          <TextBlock Text="!" Foreground="{DynamicResource YaacFailure}" FontSize="10" FontWeight="Bold"
                     HorizontalAlignment="Right" Margin="0,0,2,0"
                     Visibility="{Binding Data.Attention, Converter={StaticResource AgentsVisible}}" />
        </Grid>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="AgentsHeading">
      <TextBlock Text="{Binding Data.Title}" Margin="6,8,3,4" FontWeight="SemiBold"
                 AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AgentsMeta}" />
    </DataTemplate>
    <DataTemplate x:Key="AgentsInfo">
      <TextBlock Text="{Binding Data.Title}" Margin="6,2,6,4" Style="{StaticResource AgentsMeta}" />
    </DataTemplate>
    <DataTemplate x:Key="AgentsRoot">
      <Button x:Name="OpenRoot" Style="{StaticResource AgentsLink}" Margin="1,0" Click="OpenAgent"
              Height="23" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Data.Title}">
        <TextBlock Text="{Binding Data.Title}" Style="{StaticResource AgentsMeta}" />
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="AgentsFold">
      <ToggleButton x:Name="FoldButton" Content="{Binding Data.Title}" IsChecked="{Binding Expanded, Mode=OneWay}"
                    Click="ToggleFold" HorizontalAlignment="Left" Margin="4,1" Padding="6,2"
                    FontSize="11" ToolTip="Show or hide inactive agents" />
    </DataTemplate>

    <DataTemplate x:Key="AgentsFullRow">
      <Border x:Name="Row" Padding="1" CornerRadius="6"
              Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
              PreviewMouseRightButtonUp="OnRowRightClick" PreviewKeyDown="OnRowKeyDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="OpenRow" Style="{StaticResource AgentsLink}" Click="OpenAgent" Padding="3,4"
                  HorizontalContentAlignment="Stretch" IsEnabled="{Binding Data.CanOpen}"
                  ToolTip="{Binding Data.Tooltip}" ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="{Binding Data.Tooltip}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ContentControl x:Name="CardLogo" Content="{Binding Data}" Margin="0,0,4,0"
                              ContentTemplate="{StaticResource AgentsHarness}" Focusable="False" IsTabStop="False" />
              <Grid x:Name="DockMark" Width="18" Height="18" Visibility="Collapsed" Margin="0,0,3,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Data.Mark}" Foreground="{Binding Data.MarkColor}" TextAlignment="Center" FontWeight="SemiBold" />
                <preview:RunningSpinner Width="14" Height="14" Foreground="{Binding Data.MarkColor}"
                                        Fast="{Binding Data.Fast}" Ultrafast="{Binding Data.Ultrafast}"
                                        Visibility="{Binding Data.Running, Converter={StaticResource AgentsVisible}}" />
              </Grid>
              <StackPanel Grid.Column="1">
                <DockPanel>
                  <TextBlock x:Name="RowAge" DockPanel.Dock="Right" Text="{Binding Data.Age}" Style="{StaticResource AgentsMeta}"
                             Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Last activity"
                             Visibility="{Binding Data.HasAge, Converter={StaticResource AgentsVisible}}" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Data.Flow}" FontWeight="SemiBold"
                             Margin="2,0,0,0" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Data.Traits}"
                             Foreground="{DynamicResource YaacMuted}" Margin="2,0,0,0" />
                  <TextBlock x:Name="MarkWord" DockPanel.Dock="Right" Text="{Binding Data.MarkLabel}"
                             FontSize="11" Foreground="{Binding Data.MarkColor}" Margin="4,0,0,0"
                             Visibility="Collapsed" VerticalAlignment="Center" />
                  <TextBlock x:Name="Title" Text="{Binding Data.Title}" FontWeight="SemiBold"
                             Style="{StaticResource AgentsText}" />
                </DockPanel>
                <TextBlock x:Name="LastAction" Text="{Binding Data.LastAction}" Style="{StaticResource AgentsMeta}"
                           Visibility="{Binding Data.HasLastAction, Converter={StaticResource AgentsVisible}}" />
                <StackPanel x:Name="DockDetails" Visibility="Collapsed">
                  <DockPanel Visibility="{Binding Data.HasGit, Converter={StaticResource AgentsVisible}}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Data.Behind}" Foreground="{DynamicResource YaacMuted}" FontSize="11" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Data.Ahead}" Foreground="{DynamicResource YaacSuccess}" FontSize="11" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Data.Changes}" Foreground="{DynamicResource YaacWarning}" FontSize="11" />
                    <Viewbox DockPanel.Dock="Left" Width="15" Height="15" Margin="0,0,3,0">
                      <ContentControl Content="{Binding Data}" ContentTemplate="{StaticResource AgentsHarness}"
                                      Focusable="False" IsTabStop="False" />
                    </Viewbox>
                    <TextBlock Text="{Binding Data.Branch}" Style="{StaticResource AgentsMeta}" />
                  </DockPanel>
                  <TextBlock Text="{Binding Data.Metadata}" Style="{StaticResource AgentsMeta}"
                             Visibility="{Binding Data.HasMetadata, Converter={StaticResource AgentsVisible}}" />
                  <TextBlock Text="{Binding Data.Activity}" Style="{StaticResource AgentsMeta}"
                             Visibility="{Binding Data.HasActivity, Converter={StaticResource AgentsVisible}}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Button>
          <local:PullRequestBadge Grid.Column="1" Badge="{Binding Data.Badge}" ThreadId="{Binding CommandId}"
                                  Invoked="OnPrAction" FlyoutChanged="OnPrFlyoutChanged"
                                  VerticalAlignment="Top" Margin="0,3,0,0" />
          <Button x:Name="OptionsButton" Grid.Column="2" Content="⋯" Click="OnOptions"
                  Style="{StaticResource AgentsLink}" Padding="4,0" Margin="1,1"
                  VerticalAlignment="Top" FontSize="14" Foreground="{DynamicResource YaacMuted}"
                  ToolTip="Agent actions" AutomationProperties.Name="Agent actions"
                  Visibility="{Binding Data.HasActions, Converter={StaticResource AgentsVisible}}" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="dockRow">
          <Setter TargetName="OpenRow" Property="ToolTipService.IsEnabled" Value="False" />
          <Setter TargetName="RowAge" Property="ToolTipService.IsEnabled" Value="False" />
          <Setter TargetName="CardLogo" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="DockMark" Property="Visibility" Value="Visible" />
          <Setter TargetName="MarkWord" Property="Visibility" Value="Visible" />
          <Setter TargetName="DockDetails" Property="Visibility" Value="Visible" />
          <Setter TargetName="LastAction" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Data.Unseen}" Value="True">
          <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource YaacUnread}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding MenuOpen}" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource YaacRaised}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Data.Finished}" Value="True">
          <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource YaacMuted}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <local:AgentsTemplates x:Key="AgentsTemplates" Row="{StaticResource AgentsFullRow}"
                           PillRow="{StaticResource AgentsPillRow}" PillLabel="{StaticResource AgentsPillLabel}"
                           Rule="{StaticResource AgentsRuleLine}" More="{StaticResource AgentsMore}"
                           Heading="{StaticResource AgentsHeading}" Info="{StaticResource AgentsInfo}"
                           Root="{StaticResource AgentsRoot}" Fold="{StaticResource AgentsFold}" />

    <Style x:Key="AgentsList" TargetType="ListBox">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
      <Setter Property="ItemTemplateSelector" Value="{StaticResource AgentsTemplates}" />
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter HorizontalAlignment="Stretch" />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="FloatingAnchor">
    <Border x:Name="Pill" Width="44" Margin="0" Padding="3,5" CornerRadius="21"
            HorizontalAlignment="Right" VerticalAlignment="Center"
            Background="{DynamicResource YaacCard}" BorderBrush="{DynamicResource YaacRule}" BorderThickness="1"
            Focusable="True" KeyboardNavigation.IsTabStop="True"
            AutomationProperties.Name="Related agents" ToolTip="Related agents"
            MouseEnter="OnPillEnter" MouseLeave="OnPillLeave"
            GotKeyboardFocus="OnPillFocus" LostKeyboardFocus="OnPillFocusLost"
            PreviewKeyDown="OnFloatingKeyDown">
      <ItemsControl x:Name="PillItems" ItemTemplateSelector="{StaticResource AgentsTemplates}" />
    </Border>

    <Popup x:Name="Floating" PlacementTarget="{Binding ElementName=FloatingAnchor}" Placement="Custom"
           AllowsTransparency="True" StaysOpen="True" Opened="OnFloatingOpened">
      <Border x:Name="Card" Width="300" Background="{DynamicResource YaacCard}" BorderBrush="{DynamicResource YaacRule}"
              BorderThickness="1" CornerRadius="9" Padding="9"
              TextElement.Foreground="{DynamicResource YaacText}" TextElement.FontSize="13"
              KeyboardNavigation.TabNavigation="Cycle" MouseEnter="OnCardEnter" MouseLeave="OnCardLeave"
              LostKeyboardFocus="OnPillFocusLost" PreviewKeyDown="OnFloatingKeyDown">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="2,0,0,4">
            <Button x:Name="DockButton" DockPanel.Dock="Right" Click="OnDock" Content="Dock"
                    ToolTip="Pin to the side" Padding="8,2" />
            <Thumb x:Name="FloatingGrip" DockPanel.Dock="Left" Width="18" Margin="0,0,4,0" Cursor="SizeNS"
                   ToolTip="Move Related agents" AutomationProperties.Name="Move Related agents"
                   DragDelta="OnFloatingDrag" DragCompleted="OnFloatingDragCompleted">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                  <Grid Background="Transparent">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Rectangle Width="9" Height="1" Fill="{DynamicResource YaacMuted}" Margin="0,0,0,2" />
                      <Rectangle Width="9" Height="1" Fill="{DynamicResource YaacMuted}" Margin="0,0,0,2" />
                      <Rectangle Width="9" Height="1" Fill="{DynamicResource YaacMuted}" />
                    </StackPanel>
                  </Grid>
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
            <TextBlock Text="Related agents" FontWeight="SemiBold" VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level1" />
          </DockPanel>
          <Button x:Name="MarkCard" DockPanel.Dock="Top" Content="Mark all as read" Click="OnMarkRead"
                  Style="{StaticResource AgentsLink}" HorizontalAlignment="Left" Margin="0,0,0,3" />
          <WrapPanel x:Name="CardBudget" DockPanel.Dock="Top" Margin="5,0,0,5">
            <TextBlock Text="Agent budget reached" Foreground="{DynamicResource YaacFailure}" VerticalAlignment="Center" />
            <Button x:Name="ContinueCard" Click="OnContinue" Style="{StaticResource AgentsLink}"
                    Margin="3,0,0,0" ToolTipService.ShowOnDisabled="True" />
          </WrapPanel>
          <ListBox x:Name="CardRows" Style="{StaticResource AgentsList}" />
        </DockPanel>
      </Border>
    </Popup>

    <Border x:Name="Docked" Background="{DynamicResource YaacPanel}" Padding="11,8" Visibility="Collapsed"
            MouseEnter="OnDockHover" MouseMove="OnDockHover" MouseLeave="OnDockLeave">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,5">
          <Button x:Name="UndockButton" DockPanel.Dock="Right" Click="OnUndock" Content="Undock"
                  ToolTip="Back to the pill" Padding="8,2" />
          <TextBlock Text="Related agents" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level1" />
        </DockPanel>
        <Button x:Name="MarkDock" DockPanel.Dock="Top" Content="Mark all as read" Click="OnMarkRead"
                Style="{StaticResource AgentsLink}" HorizontalAlignment="Left" Margin="0,0,0,3" />
        <TextBlock x:Name="DockBudgetText" DockPanel.Dock="Top" TextWrapping="Wrap"
                   FontSize="11" Margin="5,0,2,4" />
        <WrapPanel x:Name="DockBudget" DockPanel.Dock="Top" Margin="5,0,0,5">
          <TextBlock Text="Agent budget reached" Foreground="{DynamicResource YaacFailure}" VerticalAlignment="Center" />
          <Button x:Name="ContinueDock" Click="OnContinue" Style="{StaticResource AgentsLink}"
                  Margin="3,0,0,0" ToolTipService.ShowOnDisabled="True" />
        </WrapPanel>
        <ListBox x:Name="DockParent" DockPanel.Dock="Bottom" Style="{StaticResource AgentsList}"
                 Margin="0,8,0,0" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
        <ListBox x:Name="DockRows" Style="{StaticResource AgentsList}" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
