<UserControl x:Class="Yaac.WpfPreview.Views.ComposerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:yaac="clr-namespace:Yaac.WpfPreview"
             xmlns:views="clr-namespace:Yaac.WpfPreview.Views"
             Visibility="Collapsed"
             Loaded="ComposerLoaded" Unloaded="ComposerUnloaded">
  <UserControl.Resources>
    <DataTemplate x:Key="PermissionWarningLabel">
      <StackPanel Orientation="Horizontal">
        <Path Data="F0 M7,0 L14,12 0,12 Z M6.3,4 H7.7 V7.5 H6.3 Z M6.3,8.7 H7.7 V10.1 H6.3 Z"
              Fill="{DynamicResource YaacFailure}" VerticalAlignment="Center" Margin="0,0,5,0" />
        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>

    <Style x:Key="ComposerButton" TargetType="Button" BasedOn="{StaticResource YaacButtonBase}">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,0,4,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>
    <Style x:Key="ComposerPrimaryButton" TargetType="Button" BasedOn="{StaticResource YaacPrimaryButton}">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,0,4,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource YaacText}" />
          <Setter Property="FontWeight" Value="Normal" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ComposerQuietText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource YaacMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <Border Padding="0,6,0,0">
    <Grid>
      <StackPanel>
        <StackPanel x:Name="Notices" />
        <Border x:Name="StatusPlate" Visibility="Collapsed" Background="{DynamicResource YaacRaised}"
                CornerRadius="6" Padding="10,6" Margin="0,0,0,5">
          <StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            <WrapPanel x:Name="StatusActions" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <StackPanel x:Name="CommandArea" Visibility="Collapsed" Margin="0,0,0,6">
          <Button x:Name="CommandTitle" HorizontalAlignment="Left" Style="{StaticResource ComposerButton}"
                  FontSize="11" Foreground="{DynamicResource YaacMuted}"
                  Click="ToggleCommandsClicked" />
          <ScrollViewer x:Name="CommandScroller" MaxHeight="112" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="CommandRows" />
          </ScrollViewer>
          <StackPanel x:Name="CommandLogArea" Margin="0,4,0,0">
            <DockPanel>
              <Button x:Name="CommandLogClose" DockPanel.Dock="Right" Style="{StaticResource ComposerButton}"
                      Click="CloseCommandLogsClicked" />
              <TextBlock x:Name="CommandLogTitle" Style="{StaticResource ComposerQuietText}" />
            </DockPanel>
            <TextBlock x:Name="CommandLogStatus" Style="{StaticResource ComposerQuietText}" />
            <TextBox x:Name="CommandOutput" MaxHeight="145" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" IsReadOnly="True" FontFamily="{DynamicResource YaacCodeFont}"
                     Background="{DynamicResource YaacInput}" Foreground="{DynamicResource YaacMuted}" FontSize="11"
                     AutomationProperties.Name="Command output" />
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="QueueArea" Visibility="Collapsed" Margin="0,0,0,6">
          <TextBlock x:Name="QueueTitle" Style="{StaticResource ComposerQuietText}" Margin="0,0,0,2" />
          <ScrollViewer x:Name="QueueScroller" MaxHeight="142" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="QueueRows" />
          </ScrollViewer>
        </StackPanel>

        <WrapPanel x:Name="ProjectActions" Visibility="Collapsed" Margin="0,0,0,4" />
        <TextBlock x:Name="UltrafastWarning" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource YaacWarning}" Margin="0,0,0,5" />
        <Border x:Name="EditorPlate" Visibility="Collapsed" Background="{DynamicResource YaacInput}" BorderThickness="1"
                CornerRadius="6" Padding="8,4,4,5">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="BorderBrush" Value="Transparent" />
              <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource YaacAccent}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
          <!-- `!` mode (P346): a faint shell-colour tint and a 3 px bar on the left edge. -->
          <Border x:Name="ShellTint" Visibility="Collapsed" Margin="-8,-4,-4,-5" CornerRadius="5"
                  Background="{DynamicResource YaacShell}" Opacity="0.07" IsHitTestVisible="False" />
          <Border x:Name="ShellBar" Visibility="Collapsed" Margin="-8,-4,0,-5" Width="3" HorizontalAlignment="Left"
                  CornerRadius="5,0,0,5" Background="{DynamicResource YaacShell}" IsHitTestVisible="False" />
          <StackPanel>
            <DockPanel x:Name="ShellRow" Visibility="Collapsed" Margin="3,2,0,1">
              <Button x:Name="ShellLeave" DockPanel.Dock="Right" Style="{StaticResource YaacQuietButton}"
                      Width="20" Height="20" Padding="0" Focusable="False" Click="ShellLeaveClicked"
                      ToolTip="Back to a message (Backspace at the start)" AutomationProperties.Name="Leave command mode">
                <TextBlock Text="×" FontSize="14" Margin="0,-2,0,0" Foreground="{DynamicResource YaacMuted}" />
              </Button>
              <ContentControl x:Name="ShellIcon" Width="14" Height="14" Margin="1,0,6,0" VerticalAlignment="Center"
                              Focusable="False" IsTabStop="False" />
              <TextBlock x:Name="ShellPrompt" Style="{StaticResource ComposerQuietText}" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <WrapPanel x:Name="AttachmentRows" Visibility="Collapsed" Margin="0,3,0,3" />
            <Grid SizeChanged="EditorRowSizeChanged">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid TextOptions.TextRenderingMode="Grayscale">
                <TextBox x:Name="Editor" FontSize="14.5" AcceptsReturn="True" TextWrapping="Wrap"
                         MinLines="3" MaxLines="5" Padding="4,3" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource YaacText}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled" InputMethod.IsInputMethodEnabled="True"
                         PreviewKeyDown="EditorKeyDown" TextChanged="EditorTextChanged"
                         SelectionChanged="EditorComposerSelectionChanged" GotKeyboardFocus="EditorFileSelectionChanged"
                         LostKeyboardFocus="EditorLostFocus" AutomationProperties.Name="Message">
                  <TextBox.Resources>
                    <!-- EditorPlate draws the composer's focus border. -->
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                  </TextBox.Resources>
                </TextBox>
                <views:ComposerMarkdown x:Name="Markdown" Panel.ZIndex="-1" IsHitTestVisible="False" Focusable="False"
                                        AccentBrush="{DynamicResource YaacMuted}" CodeBrush="{DynamicResource YaacRaised}" />
                <Popup x:Name="FilePopup" Placement="Top" PlacementTarget="{Binding ElementName=Editor}">
                  <Border Background="{DynamicResource YaacRaised}" BorderBrush="{DynamicResource YaacMuted}"
                          BorderThickness="1" CornerRadius="5" Padding="5">
                    <StackPanel Width="340">
                      <TextBlock x:Name="FileSearchHint" Style="{StaticResource ComposerQuietText}" Margin="5,3" />
                      <ListBox x:Name="FileMatches" MaxHeight="174" Focusable="False" BorderThickness="0"
                               Foreground="{DynamicResource YaacText}" Background="Transparent"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                               PreviewMouseLeftButtonUp="FileMatchClicked" AutomationProperties.Name="Working directory files">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" />
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                          <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                          </Style>
                        </ListBox.ItemContainerStyle>
                      </ListBox>
                    </StackPanel>
                  </Border>
                </Popup>
                <Popup x:Name="SkillPopup" PlacementTarget="{Binding ElementName=Editor}" Placement="Top"
                       StaysOpen="True" AllowsTransparency="True" Focusable="False" IsOpen="False">
                  <Border Background="{DynamicResource YaacRaised}" BorderBrush="{DynamicResource YaacRule}"
                          BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,4" MinWidth="320" MaxWidth="520"
                          Focusable="False">
                    <StackPanel Focusable="False">
                      <TextBlock x:Name="SkillNote" Style="{StaticResource ComposerQuietText}" Margin="4,2" Visibility="Collapsed" />
                      <Button x:Name="SkillRetryButton" Content="Retry" Style="{StaticResource ComposerButton}"
                              Visibility="Collapsed" Focusable="False" HorizontalAlignment="Left" Click="SkillRetryClicked" />
                      <ScrollViewer x:Name="SkillScroller" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="SkillRows" Focusable="False" />
                      </ScrollViewer>
                    </StackPanel>
                  </Border>
                </Popup>
                <TextBlock x:Name="Placeholder" Foreground="{DynamicResource YaacMuted}"
                           FontSize="{Binding FontSize, ElementName=Editor}"
                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Margin="5,4,6,0" />
              </Grid>
              <WrapPanel x:Name="EditorActions" Grid.Column="1" MaxWidth="330" Margin="4,0,0,0"
                         HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="AttachButton" Style="{StaticResource ComposerButton}" Click="AttachClicked" />
                <Button x:Name="SendButton" Style="{StaticResource ComposerPrimaryButton}" Click="SendClicked" />
                <Button x:Name="SendNowButton" Style="{StaticResource ComposerButton}" Click="SendNowClicked" />
                <Button x:Name="StopButton" Style="{StaticResource ComposerButton}" Click="StopClicked" />
                <Button x:Name="CancelEditButton" Style="{StaticResource ComposerButton}" Click="CancelEditClicked" />
                <Button x:Name="VoiceButton" Style="{StaticResource ComposerButton}" Click="VoiceClicked" Visibility="Collapsed" />
              </WrapPanel>
            </Grid>
            <TextBlock x:Name="Hint" Style="{StaticResource ComposerQuietText}" Margin="4,3,5,0" />
            <TextBlock x:Name="VoiceStatus" Style="{StaticResource ComposerQuietText}" Margin="4,3,5,0"
                       FontStyle="Italic" TextWrapping="Wrap" Visibility="Collapsed" />
          </StackPanel>
          </Grid>
        </Border>
        <WrapPanel x:Name="ControlActions" Visibility="Collapsed" Margin="0,6,0,0">
          <StackPanel x:Name="ContextMeter" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,4,3"
                      ToolTip="How full the context window is" Visibility="Collapsed">
            <ProgressBar x:Name="ContextProgress" Width="64" Foreground="{DynamicResource YaacMuted}" Height="4" Maximum="100"
                         AutomationProperties.Name="Context used" />
            <TextBlock x:Name="ContextLabel" Style="{StaticResource ComposerQuietText}" Margin="5,0,0,0" />
          </StackPanel>
          <TextBlock x:Name="ControlNote" Style="{StaticResource ComposerQuietText}" VerticalAlignment="Center"
                     Margin="4,0,0,3" Visibility="Collapsed" />
          <WrapPanel x:Name="ForkActions" Margin="6,0,0,0" />
          <Button x:Name="TerminalToggle" Visibility="Collapsed" Margin="2,0,0,0"/>
        </WrapPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
