<UserControl x:Class="Yaac.WpfPreview.Views.ImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.TabNavigation="Cycle">
  <Grid Background="#77000000">
    <Border Margin="24,48,24,24" Padding="12" CornerRadius="8" Background="{DynamicResource YaacCard}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="ZoomOut" Content="−" Click="ZoomOutClicked" AutomationProperties.Name="Zoom out" />
            <Button x:Name="ZoomIn" Content="+" Click="ZoomInClicked" AutomationProperties.Name="Zoom in" />
            <Button x:Name="Fit" Content="Fit" Click="FitClicked" AutomationProperties.Name="Reset zoom and fit image" />
            <Button x:Name="CloseButton" Content="Close" Click="CloseClicked" />
          </StackPanel>
          <TextBlock x:Name="ImageName" Margin="3,0,12,0" VerticalAlignment="Center"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Grid Grid.Row="1" Background="{DynamicResource YaacInput}" ClipToBounds="True">
          <Canvas x:Name="Viewport" Background="Transparent" ClipToBounds="True"
                  SizeChanged="ViewportResized" MouseWheel="ViewportWheel"
                  MouseLeftButtonDown="PanStarted" MouseMove="PanMoved"
                  MouseLeftButtonUp="PanEnded" LostMouseCapture="PanLost">
            <Image x:Name="Picture" Stretch="Fill" IsHitTestVisible="False" />
          </Canvas>
          <TextBlock x:Name="ViewerStatus" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="16" TextWrapping="Wrap" IsHitTestVisible="False"
                     AutomationProperties.LiveSetting="Polite" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
