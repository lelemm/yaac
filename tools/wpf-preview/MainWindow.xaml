<Window x:Class="Yaac.WpfPreview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:Yaac.WpfPreview"
        xmlns:views="clr-namespace:Yaac.WpfPreview.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="YAAC · WPF preview" Icon="Assets/yaac.ico" Width="1440" Height="900" MinWidth="960" MinHeight="600"
        ResizeMode="CanResize" WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource YaacCanvas}" Foreground="{DynamicResource YaacText}"
        FontFamily="{x:Static preview:YaacFonts.Ui}" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="WindowKey" PreviewMouseDown="WindowMouse">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="5" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Template>
    <ControlTemplate TargetType="Window">
      <Border Background="{TemplateBinding Background}">
        <AdornerDecorator Margin="{TemplateBinding Padding}">
          <ContentPresenter />
        </AdornerDecorator>
      </Border>
    </ControlTemplate>
  </Window.Template>
  <Window.Resources>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource YaacQuietButton}">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource YaacMuted}" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>
    <Style x:Key="PaneSplitter" TargetType="Thumb">
      <Setter Property="Width" Value="7" />
      <Setter Property="Cursor" Value="SizeWE" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Border x:Name="Rule" Width="1" Background="{DynamicResource YaacRule}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Rule" Property="Width" Value="2" />
                <Setter TargetName="Rule" Property="Background" Value="{DynamicResource YaacAccent}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Rule" Property="Width" Value="2" />
                <Setter TargetName="Rule" Property="Background" Value="{DynamicResource YaacAccent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource YaacQuietButton}">
      <Setter Property="Width" Value="40" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <BooleanToVisibilityConverter x:Key="RailVisible" />
    <DataTemplate x:Key="RailThreadMark">
      <Grid Width="28" Height="28" IsHitTestVisible="False" ToolTipService.IsEnabled="False">
        <Border x:Name="Initial" Width="18" Height="18" BorderThickness="1" CornerRadius="9"
                BorderBrush="{DynamicResource YaacMuted}" Margin="0,0,3,3" Visibility="Collapsed">
          <TextBlock Text="{Binding State.HarnessInitial}" FontSize="10" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Path x:Name="Logo" Data="{Binding State.HarnessLogo}" Fill="{Binding State.HarnessColor}"
              Margin="0,0,3,3" Width="18" Height="18" Stretch="Uniform" />
        <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,3,3"
                BorderThickness="1.5" BorderBrush="{DynamicResource YaacUnread}"
                Visibility="{Binding State.Unseen, Converter={StaticResource RailVisible}}" />
        <Border x:Name="Badge" Width="12" Height="12" CornerRadius="6" VerticalAlignment="Bottom"
                HorizontalAlignment="Right" Background="{DynamicResource YaacPanel}">
          <Grid>
            <TextBlock x:Name="BadgeText" Text="{Binding State.Mark}" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource YaacMuted}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <preview:RunningSpinner x:Name="BadgeSpinner" Width="10" Height="10" Visibility="Collapsed"
                                    Foreground="{DynamicResource YaacText}"
                                    Fast="{Binding State.Fast}" Ultrafast="{Binding State.Ultrafast}" />
          </Grid>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State.HarnessLogo}" Value="{x:Null}">
          <Setter TargetName="Initial" Property="Visibility" Value="Visible" />
          <Setter TargetName="Logo" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.MarkDanger}" Value="True">
          <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource YaacFailure}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Selected}" Value="True">
          <Setter TargetName="Badge" Property="Background" Value="{DynamicResource YaacSelected}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Tone}" Value="done">
          <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource YaacSuccess}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Mark}" Value="">
          <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Tone}" Value="running">
          <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
          <Setter TargetName="BadgeText" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="BadgeSpinner" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Fast}" Value="True">
          <Setter TargetName="BadgeSpinner" Property="Foreground" Value="{DynamicResource YaacFast}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Ultrafast}" Value="True">
          <Setter TargetName="BadgeSpinner" Property="Foreground" Value="{DynamicResource YaacUltrafast}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State.Dimmed}" Value="True">
          <Setter TargetName="Initial" Property="Opacity" Value=".53" />
          <Setter TargetName="Logo" Property="Opacity" Value=".53" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid LayoutTransform="{DynamicResource YaacUiScale}">
    <Grid x:Name="Workspace">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="280" />
        <ColumnDefinition x:Name="SidebarGap" Width="1" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <views:SidebarView x:Name="SidebarPane" />
      <Border x:Name="SidebarRail" Visibility="Collapsed" Background="{DynamicResource YaacPanel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Y" Height="42" HorizontalAlignment="Center" Padding="0,9,0,0" FontWeight="Bold" FontSize="18" />
            <Button x:Name="RailExpand" Style="{StaticResource RailButton}" Content="◫" Click="SidebarClicked"
                    AutomationProperties.Name="Expand sidebar" ToolTip="Expand the sidebar (Ctrl+B)" />
            <Button Style="{StaticResource RailButton}" Content="+" Click="RailNewClicked"
                    AutomationProperties.Name="New thread" ToolTip="New thread (Ctrl+N)" />
            <UniformGrid Rows="1">
              <Button x:Name="RailBack" Padding="0" Content="‹" Click="BackClicked" AutomationProperties.Name="Back" />
              <Button x:Name="RailForward" Padding="0" Content="›" Click="ForwardClicked" AutomationProperties.Name="Forward" />
            </UniformGrid>
            <Button x:Name="RailNeeds" Style="{StaticResource RailButton}" Click="NeedsClicked" AutomationProperties.Name="Needs you" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                        ScrollChanged="RailScrolled">
            <StackPanel x:Name="RailItems" />
          </ScrollViewer>
          <StackPanel Grid.Row="2">
            <views:UsageMeter x:Name="RailUsage" Compact="True" Visibility="Collapsed" />
            <Button Style="{StaticResource RailButton}" Content="⚙" Click="SettingsClicked"
                    AutomationProperties.Name="Settings" ToolTip="Settings (Ctrl+,)" />
          </StackPanel>
          <Popup x:Name="RailHover" Placement="Custom" AllowsTransparency="True" Focusable="False"
                 Opened="RailHoverChanged" Closed="RailHoverChanged">
            <Border x:Name="RailHoverCard" Width="300" Padding="5" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource YaacRaised}" BorderBrush="{DynamicResource YaacRule}"
                    MouseEnter="RailHoverEnter" MouseLeave="RailHoverLeave">
              <ContentControl x:Name="RailHoverHost" FontFamily="{x:Static preview:YaacFonts.Ui}"
                              FontSize="13.5" Foreground="{DynamicResource YaacText}" />
            </Border>
          </Popup>
        </Grid>
      </Border>
      <Thumb x:Name="SidebarSplitter" Grid.Column="1" Panel.ZIndex="3" Style="{StaticResource PaneSplitter}"
             Margin="-3,0,-3,0" HorizontalAlignment="Center" IsHitTestVisible="False"
             DragStarted="PaneDragStarted" DragDelta="PaneDragDelta" DragCompleted="PaneDragCompleted"
             AutomationProperties.Name="Resize sidebar" />
      <Grid Grid.Column="2" x:Name="ThreadContent" SizeChanged="ThreadContentSizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="CaptionThreadHeader" Margin="28,0,176,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" MaxWidth="560" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid x:Name="ThreadMarkSlot" Width="25" Margin="0,0,4,0" VerticalAlignment="Center">
            <TextBlock x:Name="ThreadMark" FontSize="21" VerticalAlignment="Center" />
            <preview:RunningSpinner x:Name="ThreadSpinner" Width="20" Height="20" Visibility="Collapsed" />
          </Grid>
          <TextBlock x:Name="ThreadTitle" Grid.Column="1" VerticalAlignment="Center"
                     FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          <Border x:Name="ThreadTag" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource YaacRaised}"
                  CornerRadius="4" Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="ThreadTagText" />
          </Border>
          <StackPanel x:Name="HeaderBudget" Grid.Column="3" Visibility="Collapsed" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="8,0,0,0">
            <TextBlock Text="Agent budget reached" VerticalAlignment="Center" Foreground="{DynamicResource YaacMuted}" />
            <Button Content="Continue" Click="ContinueClicked" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" x:Name="ThreadColumns" SizeChanged="ChatRegionSizeChanged">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BrowserChatColumn" Width="*" />
            <ColumnDefinition x:Name="BrowserDividerColumn" Width="0" />
            <ColumnDefinition x:Name="BrowserColumn" Width="0" />
          </Grid.ColumnDefinitions>
          <Grid x:Name="ChatRegion" ClipToBounds="True" SizeChanged="ChatRegionSizeChanged">
            <Grid.RowDefinitions>
              <RowDefinition x:Name="ConversationRow" Height="*"/>
              <RowDefinition x:Name="TerminalDividerRow" Height="0"/>
              <RowDefinition x:Name="TerminalPanelRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid x:Name="ChatWork" ClipToBounds="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition x:Name="DockColumn" Width="0"/>
            </Grid.ColumnDefinitions>
          <Grid x:Name="BrowserChat" SizeChanged="BrowserChatSizeChanged">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="HeaderDetails" Margin="60,3,26,6">
              <TextBlock x:Name="ThreadLocation" Foreground="{DynamicResource YaacMuted}" TextTrimming="CharacterEllipsis" />
              <StackPanel x:Name="HeaderLinks" Orientation="Horizontal" />
              <Button x:Name="BrowserExternalFallback" HorizontalAlignment="Left" Visibility="Collapsed"
                      Style="{StaticResource YaacQuietButton}" Content="Open in browser"
                      Click="BrowserExternalClicked" />
              <StackPanel x:Name="HeaderBanners" />
            </StackPanel>
            <Grid Grid.Row="1" x:Name="ChatSurface" Background="Transparent">
              <views:TranscriptView x:Name="TranscriptPane" HorizontalAlignment="Center" />
              <DockPanel x:Name="TranscriptPreview" Background="{DynamicResource YaacCanvas}"
                         Visibility="Collapsed" IsHitTestVisible="False" KeyboardNavigation.TabNavigation="None">
                <TextBlock x:Name="TranscriptPreviewTitle" DockPanel.Dock="Top" HorizontalAlignment="Center"
                           Foreground="{DynamicResource YaacMuted}" Margin="8,4" />
                <views:TranscriptView x:Name="TranscriptPreviewPane" HorizontalAlignment="Center" />
              </DockPanel>
            </Grid>
            <Grid Grid.Row="2" x:Name="ComposerColumn" HorizontalAlignment="Center" Margin="0,0,0,10">
              <views:ComposerView x:Name="ComposerPane" />
              <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="10" Height="44"
                     Margin="0,0,-6,8" Cursor="SizeWE" DragDelta="ComposerResize"
                     ToolTip="Resize chat and composer" AutomationProperties.Name="Resize chat and composer">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                      <Border Width="2" Height="21" CornerRadius="1" Background="{DynamicResource YaacMuted}" Opacity=".45" />
                    </Grid>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Grid>
            <Grid x:Name="ComposerDropOverlay" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False">
              <Border Background="{DynamicResource YaacSelected}" BorderBrush="{DynamicResource YaacAccent}"
                      BorderThickness="1" Opacity=".84" />
              <TextBlock Text="Drop to attach" HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontSize="17" FontWeight="SemiBold" />
            </Grid>
          </Grid>
      <views:AgentsView Grid.Column="1" x:Name="AgentsPane" Panel.ZIndex="2"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" />
      <Thumb x:Name="DockSplitter" Grid.Column="1" Panel.ZIndex="3" Style="{StaticResource PaneSplitter}"
             Margin="-3.5,0,0,0" HorizontalAlignment="Left" Visibility="Collapsed"
             DragStarted="PaneDragStarted" DragDelta="PaneDragDelta" DragCompleted="PaneDragCompleted"
             AutomationProperties.Name="Resize docked agents panel" />
          </Grid>
            <GridSplitter x:Name="TerminalDivider" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource YaacRule}"
                          DragCompleted="TerminalHeightChanged" Visibility="Collapsed" AutomationProperties.Name="Resize terminal panel"/>
            <ContentControl Grid.Row="2" x:Name="TerminalPanelHost" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
          </Grid>
          <GridSplitter x:Name="BrowserDivider" Grid.Column="1" HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" Background="{DynamicResource YaacRule}"
                        ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                        Visibility="Collapsed" DragStarted="BrowserDragStarted" DragCompleted="BrowserDragCompleted"
                        PreviewKeyUp="BrowserDividerKeyUp"
                        AutomationProperties.Name="Resize chat and browser" />
          <views:BrowserView x:Name="BrowserPane" Grid.Column="2" Visibility="Collapsed" />
        </Grid>
      </Grid>
    </Grid>

    <views:SettingsView x:Name="SettingsPane" Visibility="Collapsed" />
    <StackPanel Panel.ZIndex="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Grid x:Name="CaptionUpdate" Width="44" Height="42" Visibility="Collapsed" Background="Transparent"
            shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="CaptionUpdateButton" Style="{StaticResource CaptionButton}" Click="CaptionUpdateClicked" />
        <ProgressBar x:Name="CaptionUpdateProgress" Minimum="0" Maximum="1" Width="28" Height="4"
                     VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"
                     Foreground="{DynamicResource YaacMuted}" Background="{DynamicResource YaacRule}" />
      </Grid>
      <Button x:Name="CaptionAddPane" Style="{StaticResource CaptionButton}" Content="+"
              Click="CaptionAddClicked" AutomationProperties.Name="Add pane" ToolTip="Add pane" />
      <Button Style="{StaticResource CaptionButton}" Content="&#xEABA;" Click="MinimizeClicked"
              AutomationProperties.Name="Minimize" ToolTip="Minimize" />
      <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xEAB9;" Click="MaximizeClicked"
              AutomationProperties.Name="Maximize" ToolTip="Maximize" />
      <Button Style="{StaticResource CaptionButton}" Content="&#xEAB8;" Click="CloseClicked"
              AutomationProperties.Name="Close" ToolTip="Close" />
    </StackPanel>
    <DockPanel x:Name="StatusNotice" Panel.ZIndex="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"
               Background="{DynamicResource YaacCanvas}" Margin="5" MaxWidth="640" Visibility="Collapsed">
      <Button DockPanel.Dock="Right" Style="{StaticResource YaacQuietButton}" Content="&#x00D7;" Padding="6,1"
              Click="DismissStatusClicked" AutomationProperties.Name="Dismiss notice" ToolTip="Dismiss notice" />
      <TextBlock x:Name="Status" Foreground="{DynamicResource YaacFailure}" TextWrapping="Wrap"
                 VerticalAlignment="Center" Margin="5,1" />
    </DockPanel>
    <StackPanel x:Name="WslNotifications" Panel.ZIndex="4" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Margin="16" MaxWidth="330" />
    <Grid x:Name="CommanderOverlay" Panel.ZIndex="5" Visibility="Collapsed"
          PreviewKeyDown="CommanderKeyDown" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Border Background="#50000000" MouseLeftButtonDown="CommanderOutsideClicked"
              MouseRightButtonDown="CommanderOutsideClicked" />
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
              Width="620" MaxHeight="500" Padding="12" CornerRadius="8"
              Background="{DynamicResource YaacPanel}" KeyboardNavigation.TabNavigation="Cycle">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBox x:Name="CommanderQuery" Margin="0,0,0,8" TextChanged="CommanderQueryChanged"
                   AutomationProperties.Name="Search commands" />
          <ListBox x:Name="CommanderRows" Grid.Row="1" Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{StaticResource YaacNavigationItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Commands" PreviewMouseLeftButtonUp="CommanderRowClicked" />
        </Grid>
      </Border>
    </Grid>
    <views:ImageViewer x:Name="ImageOverlay" Panel.ZIndex="6" Visibility="Collapsed"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True" />
  </Grid>
</Window>
