<Application x:Class="Yaac.WpfPreview.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Yaac.WpfPreview"
             ThemeMode="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml" />
        <ResourceDictionary Source="Dropdowns.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ScaleTransform x:Key="YaacUiScale" ScaleX="1" ScaleY="1" />
      <Geometry x:Key="YaacSpeedBolt">M8,0 L0,8.96 4.8,8.96 2,16 10,7.04 5.2,7.04 Z</Geometry>
      <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
      <Style TargetType="ContextMenu" BasedOn="{StaticResource YaacContextMenu}">
        <Setter Property="LayoutTransform" Value="{DynamicResource YaacUiScale}" />
      </Style>
      <Style TargetType="MenuItem" BasedOn="{StaticResource YaacMenuItem}" />
      <Style TargetType="ComboBox" BasedOn="{StaticResource YaacChoice}" />
      <Style TargetType="ComboBoxItem" BasedOn="{StaticResource YaacChoiceItem}" />
      <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{x:Static local:YaacFonts.Ui}" />
        <Setter Property="LayoutTransform" Value="{DynamicResource YaacUiScale}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
