<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Yaac.WpfPreview</AssemblyName>
    <ApplicationIcon>Assets/yaac.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <None Update="LICENSE-AvalonEdit.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets/yaac.ico" />
    <Resource Include="Assets/zoom-in.cur" />
    <Resource Include="../../crates/yaac-app/assets/fonts/*NerdFont*.ttf"
              Link="Assets/Fonts/%(Filename)%(Extension)" />
    <Content Include="../../crates/yaac-app/assets/fonts/LICENSE-*.txt"
             Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
