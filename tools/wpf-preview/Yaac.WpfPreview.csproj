<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Yaac.WpfPreview</AssemblyName>
    <ApplicationIcon>Assets/yaac.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/yaac.ico" />
    <Resource Include="../../crates/yaac-app/assets/fonts/SymbolsNerdFontMono-Regular.ttf"
              Link="Assets/SymbolsNerdFontMono-Regular.ttf" />
    <Content Include="../../crates/yaac-app/assets/fonts/LICENSE-Nerd-Fonts.txt"
             Link="LICENSE-Nerd-Fonts.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
